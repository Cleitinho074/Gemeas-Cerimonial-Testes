NODE_ENV=development
PORT=4173
APP_ORIGIN=http://localhost:4173
# Copie a URI em Supabase > Connect > Session pooler, porta 5432.
# Substitua a senha e codifique caracteres especiais da senha para URL.
DATABASE_URL=postgresql://postgres.SEUPROJETO:SENHA@HOST.pooler.supabase.com:5432/postgres
# Preencha apenas se precisar do certificado CA fornecido pelo Supabase.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
